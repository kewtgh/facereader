---
layout: null
permalink: /category-index.json
sitemap: false
search: false
---
{
{% for category in site.data.category_catalog %}
  {{ category.id | jsonify }}: {
    "name": {{ category.name | jsonify }},
    "posts": [
      {% for post in category.posts %}
        {% assign teaser = post.header.teaser | default: post.header.overlay_image | default: site.teaser %}
        {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "language": {{ post.article_language | jsonify }}, "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "image": {{ teaser | relative_url | jsonify }}, "excerpt": {{ post.catalog_excerpt | truncate: 145 | jsonify }}}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
}
